---
title: Home
template: home.html
hide:
  - navigation
  - toc
---

<div class="md-grid">
  <h2>Top Task Categories</h2><hr>

  <div class="tag-card-grid" markdown>
    {% for tag in tags_with_icons %}
    <div class="tag-card">
    <a href="/Categories/{{ tag.name }}">
        {% if tag.icon_url %}
            <img class="tag-card-icon" src="{{ tag.icon_url }}" alt="{{ tag.name }} icon">
        {% endif %}
        <br>
        {{ tag.name }}
    </a>
    </div>
    {% endfor %}
     <div class="tag-card">
    <a href="/tags/">Browse All Categories</a>
    </div>
  </div>
</div>
<br><br>
<div class="home-column-container">

<div class="home-column">
  <h2> Featured Plugins </h2><hr>
  <div class="card-grid" markdown>
  {% for plugin in plugins %}
    <div class="card">
    <img class="card-icon" src="{{ plugin['owner_icon'] }}" alt="Icon" />
    <a href="/Plugins/{{ plugin['slug'] }}"><br>
    {{ plugin['name'] }}
    </a>
    </div>
  {% endfor %}
  </div>
</div>
<div class="home-column">
  <h2> Latest Skill Updates </h2><hr>
  <div class="card-grid" markdown>
  {% for skill in top_latest_files %}
    <div class="card">
    {% if 'health' in skill["slug"].split("/")[-1] %}
      <img class="card-icon" src="https://storage.googleapis.com/runwhen-nonprod-shared-images/icons/ecg_heart.svg" alt="Icon" />
    {% elif 'tasks' in skill["slug"].split("/")[-1] %}
      <img class="card-icon" src="https://storage.googleapis.com/runwhen-nonprod-shared-images/icons/task.svg" alt="Icon" />
    {% endif %}
    <p>
    <a href="{{ skill['slug'] }}">
    {{ skill['name'] }}
    </a>
    <span style="font-size: 12px">&nbsp;{{ skill['age'] }}</span>
    </p>
    </div>
  {% endfor %}
  </div>
</div>
<div class="home-column">
  <h2> Community Resources </h2><hr>

  <div class="card-grid" markdown>
    <div class="card">
      <a href="https://docs.runwhen.com/public/v/runwhen-authors" target="_blank">
      <img class="card-icon" src="https://storage.googleapis.com/runwhen-nonprod-shared-images/icons/code_blocks.svg" alt="Icon" /> Join the (Paid) RunWhen Authors Program
      </a>
    </div>
    <div class="card">
        <a href="https://github.com/runwhen-contrib/codecollection-registry/issues/new/choose" target="_blank">
        <img class="card-icon" src="https://storage.googleapis.com/runwhen-nonprod-shared-images/icons/help_center.svg" alt="Icon" /> Request New Skills
      </a>
    </div> 
        <div class="card">
        <a href="https://runwhen.slack.com/join/shared_invite/zt-1l7t3tdzl-IzB8gXDsWtHkT8C5nufm2A#/shared-invite/email" target="_blank">
        <img class="card-icon" src="https://storage.googleapis.com/runwhen-nonprod-shared-images/icons/slack_black.svg" alt="Icon" />
       Connect on Slack
      </a>
    </div> 
  </div>
</div>

</div>